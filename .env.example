# Public env vars — exposed to browser, MUST start with NEXT_PUBLIC_
NEXT_PUBLIC_APP_NAME="智鸢无人机运营平台"
NEXT_PUBLIC_API_MODE=remote
NEXT_PUBLIC_API_URL=http://localhost:8080

# Map provider. Without a key the console uses its built-in test map, which needs no account
# and is what CI and the test suite run against. Coordinates are WGS-84 everywhere; the AMap
# provider is the only code that converts to GCJ-02. See docs ADR 0006.
# NEXT_PUBLIC_AMAP_KEY=

# Speech recognition: browser (default, Web Speech API) | volcengine | none.
# NEXT_PUBLIC_ASR_PROVIDER=browser
# The Volcengine gateway is OUR server, not Volcengine — it holds the app credentials and
# signs the upstream connection. Never point this straight at Volcengine.
# NEXT_PUBLIC_ASR_GATEWAY_URL=wss://asr.example.com/stream

# Private env vars (server-only, NOT exposed to browser).
# Add server-only secrets below this line as your project grows.
# Spring server (copy these values into your process environment; do not expose them to the browser)
#
# SPRING_PROFILES_ACTIVE is load-bearing. Anything that is NOT development/dev/test is
# treated as production, and ProductionConfigGuard refuses to start when the settings below
# are still at their development values. Forgetting the profile produces a refusal with a
# list of what to fix — never a quietly insecure deployment.
# SPRING_PROFILES_ACTIVE=development
# DB_URL=jdbc:mysql://localhost:3306/zhiyuan?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# DB_USERNAME=zhiyuan
# DB_PASSWORD=zhiyuan-dev
# JWT_SECRET=replace-with-at-least-32-random-bytes
# CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost
# UAV_SIMULATOR_ENABLED=true
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/dev
# UPDATE_MANIFEST_URL=
